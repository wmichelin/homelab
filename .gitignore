# Secrets (single source of truth on the host)
secrets/homelab.env
secrets/*.txt
secrets/*.key
secrets/g5-caddy-root.crt
secrets/headscale-preauth.key

# Materialized / local env (generated by scripts/materialize-env.sh)
.env
.env.local
**/.env
!.env.example
!**/.env.example
!secrets/homelab.env.example
apple-photos-export/config.env

# Dynamic DNS rendered config (contains password)
ddclient.conf

# Terraform local state / secrets (headscale DNS)
terraform/**/.terraform/
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/**/terraform.tfvars

# Docker volumes and runtime data
grafana-data/
prometheus-data/
apps/media-stack/config/
apps/immich/library/
apps/immich/postgres/
apps/exporters/textfile/*.prom
apps/headscale/data/

# Backups / logs / archives
backups/
logs/
*.log
*.tar.gz
*.tar.gz.gpg

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Temporary files
*.tmp
*.temp
.tmp/

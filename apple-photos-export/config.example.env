# Copy to config.env and edit. config.env is gitignored.
#
#   cp config.example.env config.env

# Required: destination root (e.g. a mounted NAS volume)
PHOTOS_EXPORT_ROOT=/path/to/export/root

# Optional overrides (defaults shown)
# PHOTOS_DEST="${PHOTOS_EXPORT_ROOT}/Photos"
# LIVE_DEST="${PHOTOS_EXPORT_ROOT}/Live Photos"
# PHOTOS_LIBRARY="${HOME}/Pictures/Photos Library.photoslibrary"
# OSXPHOTOS_SUPPORT="${HOME}/Library/Application Support/osxphotos"
# PHOTOS_EXPORT_DB="${OSXPHOTOS_SUPPORT}/photos-export.db"
# LIVE_MOVIES_STATE="${OSXPHOTOS_SUPPORT}/live-movies.json"

# Incremental window for osxphotos --added-in-last (e.g. 7d, 2 weeks).
# Scheduled LaunchAgent defaults to 7d if unset. Use all/full for whole library.
# Manual ./export-photos.sh ignores this unless set (full library by default).
# PHOTOS_ADDED_IN_LAST=7d

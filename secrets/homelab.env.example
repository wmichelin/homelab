# Homelab secrets + local config (single source of truth).
# Copy to secrets/homelab.env and fill in real values:
#   cp secrets/homelab.env.example secrets/homelab.env && chmod 600 secrets/homelab.env
#
# Never commit secrets/homelab.env. Deploy scripts materialize per-app .env files
# from this file so Docker only receives the keys each stack needs.

# --- Raspberry Pi monitoring stack (docker-compose.yml) ---
DDNS_PASSWORD=your_namecheap_ddns_password_here
HOMELAB_SUBDOMAIN=your_random_subdomain_here
DOMAIN=yourdomain.com
EMAIL=your-email@domain.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
HE_URI=http://your_hub_ip/apps/api/20/devices
HE_TOKEN=your_hubitat_maker_api_token_here

# --- G5 LAN remote access ---
RDP_USER=wmichelin
RDP_PASSWORD=change_me
# VNC passwords are max 8 characters
VNC_PASSWORD=change_me

# --- G5 Samba / share users ---
SMB_USER_WALTER=wmichelin
SMB_PASS_WALTER=change_me
SMB_USER_MARISSA=marissa
SMB_PASS_MARISSA=change_me

# --- G5 media-stack (Jellyfin / *arr / qBittorrent) ---
WEBUI_PASSWORD=change_me
QBIT_BT_PORT=6881
QBITTORRENT_USER=admin
QBITTORRENT_WEBUI_PASSWORD=change_me
JELLYFIN_USER=wmichelin
JELLYFIN_PASSWORD=change_me
JELLYFIN_URL=http://192.168.0.54:8096
RADARR_URL=http://192.168.0.54:7878
RADARR_API_KEY=change_me
PROWLARR_URL=http://192.168.0.54:9696
PROWLARR_API_KEY=change_me

# --- G5 Immich ---
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
TZ=America/New_York
IMMICH_VERSION=v3
DB_PASSWORD=change-me-alphanumeric-only
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
